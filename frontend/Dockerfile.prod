# ============================================
# VocabWeaver Frontend Production Dockerfile
# ============================================
# 多阶段构建：
# Stage 1: Node.js 构建静态文件
# Stage 2: Nginx 托管静态文件 (HTTPS)
# ============================================

# ============================================
# Stage 1: Build (Node.js)
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# ---------- Install Dependencies ----------
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --legacy-peer-deps || npm install

# ---------- Copy Source ----------
COPY frontend/ .

# ---------- Environment Variables ----------
ARG VITE_API_BASE_URL=https://localhost
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# ---------- Build ----------
RUN npm run build

# ============================================
# Stage 2: Production (Nginx + HTTPS)
# ============================================
FROM nginx:alpine AS production

# ---------- Remove Default Config ----------
RUN rm /etc/nginx/conf.d/default.conf

# ---------- Copy Production Config ----------
COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf

# ---------- Copy Built Assets ----------
COPY --from=builder /app/dist /usr/share/nginx/html

# ---------- Create SSL Directory ----------
RUN mkdir -p /etc/nginx/ssl

# ---------- Non-root User (Security) ----------
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /etc/nginx/ssl \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# ---------- Expose Ports ----------
EXPOSE 80 443

# ---------- Health Check ----------
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
